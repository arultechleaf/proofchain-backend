# ── BACKEND (NestJS API) settings ─────────────────────────────────────────────
# Copy to .env and fill in. Frontend settings live in frontend/.env, not here.
# .env.local (optional) overrides .env on your PC, e.g. a local MySQL.
# On Render, set these under the service's Environment tab instead.

NODE_ENV=development
APP_PORT=3001

# Database (Railway MySQL in production; local MySQL in .env.local)
DB_TYPE=mysql
DB_HOST=
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=
# true only on a local dev database; production uses database/*.sql migrations
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=10
OTP_SECRET=

# Frontends allowed to call the API (comma-separated)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Subscriptions
SUBSCRIPTION_REQUIRED=true
SUBSCRIPTION_EXEMPT_ROLES=admin,customer,shop_owner,shop_worker

# Payments (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAYX_PAYOUTS_ENABLED=false
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
RAZORPAYX_QUEUE_IF_LOW_BALANCE=true
CLAIM_BANK_ENCRYPTION_KEY=

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Blockchain
BLOCKCHAIN_MODE=
BESU_RPC_URL=
BESU_CHAIN_ID=
BESU_SIGNER_PRIVATE_KEY=
CONTRACT_ADDRESS=

# Misc
THROTTLE_TTL=60
THROTTLE_LIMIT=100
LOG_LEVEL=log

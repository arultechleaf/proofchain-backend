<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS reverse proxy for ProofChain (see docs/iis-local-hosting.md).
  Needs the IIS "URL Rewrite" and "Application Request Routing" (ARR) modules,
  with ARR's proxy switched on at server level.

    /api/*        -> NestJS backend   http://localhost:3002
    everything    -> Next.js frontend http://localhost:3001
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="ProofChain API" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://localhost:3002/api/{R:1}" />
        </rule>
        <rule name="ProofChain frontend" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://localhost:3001/{R:1}" />
        </rule>
      </rules>
    </rewrite>

    <!-- Let the apps' own error responses (JSON from the API, Next.js error pages) through,
         instead of IIS replacing them with its generic error pages. -->
    <httpErrors existingResponse="PassThrough" />

    <security>
      <requestFiltering>
        <!-- Allow uploads up to 50 MB (IIS default is 30 MB). -->
        <requestLimits maxAllowedContentLength="52428800" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>

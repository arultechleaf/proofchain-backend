{
  "expo": {
    "name": "Namma Store",
    "slug": "namma-store",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nammastore.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.nammastore.app",
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image",
      ["expo-image-picker", { "photosPermission": "Allow Namma Store to use your photos for product pictures.", "cameraPermission": "Allow Namma Store to take product photos." }],
      "expo-font",
      "expo-status-bar"
    ],
    "scheme": "nammastore",
    "experiments": {
      "typedRoutes": true
    }
  }
}
